# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.github/
!/.github/**
!/docs/
!/docs/**
!/provenance/
!/provenance/**
!/service/
!/service/**
!/skills/traceclean/
!/skills/traceclean/**
!/tests/
!/tests/**
!/web/
!/web/**
!/.dockerignore
!/.env.example
!/.gitignore
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/requirements.txt
!/SECURITY.md

# Exceptions even inside allowed trees
.env
contenttrace.db
contenttrace.db-journal
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak

# ── AI Watermark Lab: exclude all generated experiment artifacts ──────────────
# Temp watermarked text/image outputs written during experiments
experiments/
*.wm.txt
*.wm.png
service/scripts/temp_before_*.png
service/scripts/temp_after_*.png
service/scripts/temp_after_detect_*.png

# External harness checkouts (users clone these separately)
MarkLLM/
reverse-SynthID/
noai-watermark/
CtrlRegen/

# Hugging Face model/tokenizer caches
.cache/huggingface/
huggingface_cache/

# PyTorch and other framework caches
.cache/torch/
*.safetensors
*.bin
*.pt
*.pth

# Lab scratch and setup logs
lab_setup_*.log
setup_markllm*.log
